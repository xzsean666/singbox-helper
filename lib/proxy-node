def cmd_port_bind(port, profile_name, force=False):
    auto_init_current_profile_if_needed()
    profiles = list_profiles()
    prof = resolve_profile(profile_name, profiles)
    if prof == "multiple":
        return 1
    if not prof:
        print(f"{COLOR_RED}[✗] Profile '{profile_name}' not found. Run 'pnode profiles' to see available profiles.{COLOR_RESET}")
        return 1

    target_name = prof["name"]
    source_json = prof["path"]

    port_dir = os.path.join(PORTS_DIR, str(port))
    svc_name = f"sing-box-port@{port}"
    if os.path.exists(port_dir):
        old_prof = "unknown"
        info_f = os.path.join(port_dir, "info.json")
        if os.path.exists(info_f):
            try:
                with open(info_f, "r", encoding="utf-8") as f:
                    old_prof = json.load(f).get("profile", old_prof)
            except Exception:
                pass
        if old_prof == target_name:
            print(f"Port {port} is already running profile '{target_name}'. Updating configuration and restarting...")
        else:
            print(f"Switching Port {port} from '{old_prof}' to '{target_name}'...")
    else:
        if not is_port_bindable(port):
            print(f"{COLOR_RED}[✗] Port {port} is already in use by another application on this system.{COLOR_RESET}")
            return 1

    try:
        with open(source_json, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except Exception as e:
        print(f"{COLOR_RED}[✗] Failed to read profile config '{source_json}': {e}{COLOR_RESET}")
        return 1

    inbounds = cfg.setdefault("inbounds", [])
    mixed_ib = None
    for ib in inbounds:
        if ib.get("type") == "mixed":
            mixed_ib = ib
            break
    if not mixed_ib:
        if inbounds:
            mixed_ib = inbounds[0]
        else:
            mixed_ib = {"type": "mixed", "tag": "mixed-in"}
            inbounds.append(mixed_ib)
    mixed_ib["listen"] = "0.0.0.0"
    mixed_ib["listen_port"] = port

    api_port = allocate_api_port(port)
    cfg.setdefault("experimental", {})
    cfg["experimental"]["cache_file"] = {
        "enabled": True,
        "path": f"/var/lib/sing-box-client/cache-{port}.db",
    }
    cfg["experimental"]["clash_api"] = {
        "external_controller": f"127.0.0.1:{api_port}",
    }

    check_bin = get_sing_box_binary()
    if check_bin:
        tmp_cfg = f"/tmp/check-port-{port}-{os.getpid()}.json"
        try:
            with open(tmp_cfg, "w", encoding="utf-8") as f:
                json.dump(cfg, f)
            res = subprocess.run([check_bin, "check", "-c", tmp_cfg], capture_output=True, text=True)
            if res.returncode != 0:
                print(f"{COLOR_RED}[✗] Generated config failed sing-box validation:{COLOR_RESET}\n{res.stderr or res.stdout}")
                return 1
        finally:
            if os.path.exists(tmp_cfg):
                os.remove(tmp_cfg)

    ensure_ports_dir()
    os.makedirs(port_dir, exist_ok=True)
    dest_json = os.path.join(port_dir, "config.json")
    dest_info = os.path.join(port_dir, "info.json")

    with open(dest_json, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
    os.chmod(dest_json, 0o644)

    with open(dest_info, "w", encoding="utf-8") as f:
        json.dump({
            "port": port,
            "profile": target_name,
            "api_port": api_port,
            "created_at": time.strftime("%Y-%m-%d %H:%M:%S"),
        }, f, indent=2)
    os.chmod(dest_info, 0o644)

    ensure_port_service_template()

    print(f"Starting {svc_name} on port {port} with profile '{target_name}'...")
    subprocess.run(["systemctl", "daemon-reload"], stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "enable", "--now", svc_name], stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "restart", svc_name], stderr=subprocess.DEVNULL)

    time.sleep(1)
    res = subprocess.run(["systemctl", "is-active", "--quiet", svc_name])
    if res.returncode != 0:
        print(f"{COLOR_RED}[✗] Failed to start {svc_name}.{COLOR_RESET}")
        subprocess.run(["journalctl", "-u", svc_name, "-n", "10", "--no-pager"])
        return 1

    try:
        res = subprocess.run(["ufw", "status"], capture_output=True, text=True)
        if "Status: active" in res.stdout:
            subprocess.run([
                "ufw", "allow", "from", "172.16.0.0/12", "to", "any", "port", str(port),
                "proto", "tcp", "comment", f"Docker bridge to sing-box port {port}"
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    print(f"{COLOR_GREEN}[✓] Successfully bound port {port} to profile: {COLOR_BOLD}{target_name}{COLOR_RESET}")
    print(f"    Proxy Address: {COLOR_BOLD}127.0.0.1:{port}{COLOR_RESET} (Mixed HTTP/SOCKS5)")
    print(f"    Clash API:     127.0.0.1:{api_port}")
    print(f"    Service Unit:  {svc_name} (Active & enabled on boot)")

    time.sleep(0.5)
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{api_port}/proxies", headers={"User-Agent": "proxy-node/1.0"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            p_data = json.loads(resp.read().decode("utf-8"))
        sel = p_data.get("proxies", {}).get(PROXY_TAG, {})
        now_node = sel.get("now", "")
        if now_node:
            print(f"    Active Node:   {COLOR_GREEN}{now_node}{COLOR_RESET}")
    except Exception:
        pass
    print()
    return 0


