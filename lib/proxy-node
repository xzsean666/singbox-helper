def main():
    raw_args = sys.argv[1:]

    # Check help
    if any(arg in ("-h", "--help", "help") for arg in raw_args):
        print_help()
        sys.exit(0)

    # Check force
    force = False
    args = []
    for arg in raw_args:
        if arg in ("-f", "--force"):
            force = True
        else:
            args.append(arg)

    if not args:
        cmd_dashboard_or_list()
        sys.exit(0)

    # Check if first arg is a port (>= 1024)
    port = PORT_HTTP
    has_explicit_port = False
    if args[0].isdigit() and int(args[0]) >= 1024:
        port = int(args[0])
        has_explicit_port = True
        args = args[1:]

    if not args:
        if has_explicit_port:
            sys.exit(cmd_list(port) or 0)
        else:
            cmd_dashboard_or_list()
            sys.exit(0)

    cmd = args[0].lower()
    sub_args = args[1:]

    if cmd in ("dashboard", "dash", "status"):
        sys.exit(cmd_dashboard() or 0)
    elif cmd in ("ls", "list"):
        sys.exit(cmd_list(port) or 0)
    elif cmd in ("current", "cur"):
        cmd_current(port)
    elif cmd == "switch":
        node_target = sub_args[0] if sub_args else None
        sys.exit(cmd_switch(port, node_target) or 0)
    elif cmd == "use":
        prof_target = sub_args[0] if sub_args else None
        dest_p = port
        if len(sub_args) > 1 and sub_args[1].isdigit() and int(sub_args[1]) >= 1024:
            dest_p = int(sub_args[1])
        sys.exit(cmd_use(dest_p, prof_target, force=force) or 0)
    elif cmd == "add":
        prof_target = sub_args[0] if sub_args else None
        sys.exit(cmd_add_auto_port(prof_target, force=force) or 0)
    elif cmd in ("stop", "rm", "del-port", "unbind"):
        target = sub_args[0] if sub_args else (str(port) if has_explicit_port else None)
        sys.exit(cmd_stop(target, force=force) or 0)
    elif cmd == "test":
        test_p = port if has_explicit_port else None
        if sub_args and sub_args[0].isdigit():
            test_p = int(sub_args[0])
        sys.exit(cmd_test(test_p) or 0)
    elif cmd == "run":
        sys.exit(cmd_run(port, sub_args) or 0)
    elif cmd in ("profiles", "profile", "p"):
        sys.exit(handle_profile_cmd(sub_args, force=force) or 0)
    elif cmd in ("update", "up"):
        target = sub_args[0] if sub_args else None
        sys.exit(cmd_update(target) or 0)
    elif cmd in ("sub", "subscription"):
        sys.exit(cmd_sub(sub_args) or 0)
    elif cmd == "vless":
        sys.exit(cmd_vless(sub_args) or 0)
    elif cmd == "docker":
        sys.exit(cmd_docker(sub_args) or 0)
    elif cmd in ("port", "ports"):
        sys.exit(cmd_port_legacy(sub_args, force=force) or 0)
    elif len(args) == 1:
        # Direct node switch: e.g. `pnode 2` or `pnode 1081 3` or `pnode 日本`
        sys.exit(cmd_switch(port, args[0]) or 0)
    else:
        print(f"{COLOR_RED}Unknown command: {' '.join(raw_args)}{COLOR_RESET}")
        print("Run 'pnode --help' for usage instructions.")
        sys.exit(1)


if __name__ == "__main__":
    main()

