        profile_name = None
    else:
        vless_uri = getattr(args, "uri", None)
        profile_name = getattr(args, "name", None)

    if not vless_uri:
        if sys.stdin.isatty():
            try:
                vless_uri = input(f"{COLOR_BOLD}Enter vless:// link: {COLOR_RESET}").strip()
