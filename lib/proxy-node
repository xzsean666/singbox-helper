def cmd_update(args=None):
    auto_init_current_profile_if_needed()
    target_prof_name = None
    if isinstance(args, list):
        target_prof_name = args[0] if args else None
    elif isinstance(args, str):
        target_prof_name = args
    elif hasattr(args, "profile"):
        target_prof_name = getattr(args, "profile", None)

    profiles = list_profiles()
    current_name = get_current_profile_name()
    prof_to_update = None

    if target_prof_name:
        prof = resolve_profile(target_prof_name, profiles)
        if prof == "multiple":
            return 1
        if not prof:
            print(f"{COLOR_RED}[✗] Profile '{target_prof_name}' not found.{COLOR_RESET}")
            return 1
        prof_to_update = prof
        target_name = prof["name"]
    elif current_name:
        for p in profiles:
            if p["name"] == current_name:
                prof_to_update = p
                break
        target_name = current_name
    else:
        target_name = "current"

    sub_url = ""
    if prof_to_update:
        meta_path = prof_to_update.get("meta_path")
        if meta_path and os.path.exists(meta_path):
            try:
                with open(meta_path, "r", encoding="utf-8") as f:
                    meta = json.load(f)
                if meta.get("type") in ("subscription", "Subscription"):
                    sub_url = meta.get("source", "")
            except Exception:
                pass

    if not sub_url and os.path.exists(SUB_URL_PATH):
        try:
            with open(SUB_URL_PATH, "r", encoding="utf-8") as f:
                sub_url = f.read().strip()
        except Exception:
            pass

    if not sub_url:
        print(f"{COLOR_YELLOW}[!] Profile '{target_name}' has no subscription URL. Update skipped.{COLOR_RESET}")
        return 1

    print(f"Updating subscription for profile '{COLOR_BOLD}{target_name}{COLOR_RESET}' from: {sub_url} ...")
    converter = get_converter_path()
    if not converter:
        print(f"{COLOR_RED}[✗] sub_converter.py not found on system.{COLOR_RESET}")
        return 1

    dest_json = os.path.join(PROFILES_DIR, f"{target_name}.json")
    cmd = [sys.executable, converter, "--sub", sub_url, "--output", dest_json]
    ret = subprocess.run(cmd)
    if ret.returncode != 0:
        print(f"{COLOR_RED}[✗] Failed to convert subscription.{COLOR_RESET}")
        return 1

    node_count, _, _ = inspect_config_file(dest_json)
    meta = {
        "name": target_name,
        "type": "subscription",
        "source": sub_url,
        "node_count": node_count,
        "updated_at": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    try:
        with open(os.path.join(PROFILES_DIR, f"{target_name}.meta.json"), "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=2)
    except Exception:
        pass

    if target_name == current_name:
        shutil.copy2(dest_json, CONFIG_PATH)
        print(f"{COLOR_GREEN}[✓] Subscription updated ({node_count} nodes). Restarting primary sing-box-client...{COLOR_RESET}")
        subprocess.run(["systemctl", "restart", "sing-box-client"])
        wait_for_api(5)
        cmd_list(PORT_HTTP)
    else:
        print(f"{COLOR_GREEN}[✓] Subscription profile '{target_name}' updated ({node_count} nodes).{COLOR_RESET}")

    bound = get_bound_ports()
    for pt, p_info in bound.items():
        if p_info.get("profile") == target_name:
            print(f"Restarting port {pt} with updated profile '{target_name}'...")
            cmd_port_bind(pt, target_name, force=True)

    return 0


