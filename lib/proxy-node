#!/usr/bin/env python3
"""
CLI tool to view and switch sing-box proxy nodes via Clash API.
Installed as /usr/local/bin/proxy-node (alias: pnode).
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

API_URL = "http://127.0.0.1:9090"
PROXY_TAG = "proxy"
CONFIG_PATH = "/etc/sing-box-client/config.json"
SUB_URL_PATH = "/etc/sing-box-client/sub_url.txt"
PROFILES_DIR = "/etc/sing-box-client/profiles"
CURRENT_PROFILE_PATH = "/etc/sing-box-client/current_profile.txt"
PORTS_DIR = "/etc/sing-box-client/ports"
PORT_SERVICE_TEMPLATE = "/etc/systemd/system/sing-box-port@.service"
PORT_HTTP = 1080

COLOR_GREEN = "\033[32m"
COLOR_YELLOW = "\033[33m"
COLOR_CYAN = "\033[36m"
COLOR_RED = "\033[31m"
COLOR_BOLD = "\033[1m"
COLOR_RESET = "\033[0m"


def get_sing_box_binary():
    b = shutil.which("sing-box")
    if b:
        return b
    if os.path.exists("/usr/local/bin/sing-box"):
        return "/usr/local/bin/sing-box"
    return None


def get_converter_path():
    candidates = [
        "/etc/sing-box-client/sub_converter.py",
        "/usr/local/lib/singbox-client/sub_converter.py",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "sub_converter.py"),
    ]
    for c in candidates:
        if os.path.exists(c):
            return c
    return None


def ensure_profiles_dir():
    try:
        os.makedirs(PROFILES_DIR, exist_ok=True)
    except Exception:
        pass


def ensure_ports_dir():
    try:
        os.makedirs(PORTS_DIR, exist_ok=True)
    except Exception:
        pass


def get_current_profile_name():
    if os.path.exists(CURRENT_PROFILE_PATH):
        try:
            with open(CURRENT_PROFILE_PATH, "r", encoding="utf-8") as f:
                name = f.read().strip()
                if name:
                    return name
        except Exception:
            pass
    return None


def set_current_profile_name(name):
    try:
        ensure_profiles_dir()
        if name:
            with open(CURRENT_PROFILE_PATH, "w", encoding="utf-8") as f:
                f.write(name.strip() + "\n")
        else:
            if os.path.exists(CURRENT_PROFILE_PATH):
                os.remove(CURRENT_PROFILE_PATH)
    except Exception as e:
        print(f"Warning: could not write {CURRENT_PROFILE_PATH}: {e}")


def inspect_config_file(filepath):
    """
    Inspects a sing-box config file and returns (node_count, nodes_list, selector_tag)
    """
    node_count = 0
    nodes = []
    selector_tag = ""
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            cfg = json.load(f)
        outbounds = cfg.get("outbounds", [])
        for ob in outbounds:
            if ob.get("type") == "selector":
                selector_tag = ob.get("tag", "proxy")
                nodes = ob.get("outbounds", [])
                node_count = len(nodes)
                break
        if node_count == 0:
            proxy_obs = [ob for ob in outbounds if ob.get("type") not in ("selector", "direct", "block", "dns")]
            node_count = len(proxy_obs)
            nodes = [ob.get("tag", "") for ob in proxy_obs]
    except Exception:
        pass
    return node_count, nodes, selector_tag


def save_profile(name, config_source_path, ptype="Custom", source=""):
    ensure_profiles_dir()
    if not re.match(r'^[a-zA-Z0-9_\-]+$', name):
        print(f"{COLOR_RED}[✗] Invalid profile name '{name}'. Use letters, numbers, hyphens, underscores.{COLOR_RESET}")
        return False

    dest_json = os.path.join(PROFILES_DIR, f"{name}.json")
    dest_meta = os.path.join(PROFILES_DIR, f"{name}.meta.json")

    # Validate config
    check_bin = get_sing_box_binary()
    if check_bin:
        res = subprocess.run([check_bin, "check", "-c", config_source_path], capture_output=True, text=True)
        if res.returncode != 0:
            print(f"{COLOR_RED}[✗] Invalid sing-box configuration:{COLOR_RESET}\n{res.stderr or res.stdout}")
            return False

    shutil.copy2(config_source_path, dest_json)
    try:
        os.chmod(dest_json, 0o644)
    except Exception:
        pass

    node_count, _, _ = inspect_config_file(dest_json)

    meta = {
        "name": name,
        "type": ptype,
        "source": source,
        "node_count": node_count,
        "updated_at": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    try:
        with open(dest_meta, "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=2)
    except Exception:
        pass

    return True


def auto_init_current_profile_if_needed():
    ensure_profiles_dir()
    if not os.path.exists(CONFIG_PATH):
        return
    if not os.path.exists(PROFILES_DIR):
        return
    existing = [f for f in os.listdir(PROFILES_DIR) if f.endswith(".json") and not f.endswith(".meta.json")]
    if not existing:
        profile_name = "default"
        source = ""
        ptype = "Custom"
        if os.path.exists(SUB_URL_PATH):
            try:
                with open(SUB_URL_PATH, "r", encoding="utf-8") as f:
                    source = f.read().strip()
                if source:
                    profile_name = "clash-sub"
                    ptype = "subscription"
            except Exception:
                pass
        save_profile(profile_name, CONFIG_PATH, ptype=ptype, source=source)
        set_current_profile_name(profile_name)


def list_profiles():
    ensure_profiles_dir()
    current_name = get_current_profile_name()
    profiles = []
    if not os.path.exists(PROFILES_DIR):
        return profiles

    for fname in os.listdir(PROFILES_DIR):
        if fname.endswith(".json") and not fname.endswith(".meta.json"):
            p_name = fname[:-5]
            json_path = os.path.join(PROFILES_DIR, fname)
            meta_path = os.path.join(PROFILES_DIR, f"{p_name}.meta.json")

            mtime = os.path.getmtime(json_path)
            mtime_str = time.strftime("%Y-%m-%d %H:%M", time.localtime(mtime))
            node_count, _, _ = inspect_config_file(json_path)
            ptype = "Custom"
            source = ""

            if os.path.exists(meta_path):
                try:
                    with open(meta_path, "r", encoding="utf-8") as f:
                        meta = json.load(f)
                    ptype = meta.get("type", ptype)
                    source = meta.get("source", source)
                    if "node_count" in meta and meta["node_count"]:
                        node_count = meta["node_count"]
                except Exception:
                    pass
            else:
                if node_count > 1:
                    ptype = "subscription"
                elif node_count == 1:
                    ptype = "vless"

            is_active = (p_name == current_name)
            profiles.append({
                "name": p_name,
                "path": json_path,
                "meta_path": meta_path,
                "type": ptype,
                "source": source,
                "node_count": node_count,
                "mtime": mtime,
                "mtime_str": mtime_str,
                "is_active": is_active,
            })

    profiles.sort(key=lambda x: x["name"].lower())
    return profiles


def resolve_profile(target, profiles):
    if not target:
        return None
    target_str = str(target).strip()
    if target_str.isdigit():
        idx = int(target_str) - 1
        if 0 <= idx < len(profiles):
            return profiles[idx]
        return None
    # Exact match
    for p in profiles:
        if p["name"].lower() == target_str.lower():
            return p
    # Substring match
    matches = [p for p in profiles if target_str.lower() in p["name"].lower()]
    if len(matches) == 1:
        return matches[0]
    elif len(matches) > 1:
        print(f"{COLOR_YELLOW}[!] Multiple profiles match '{target}':{COLOR_RESET}")
        for m in matches:
            print(f"  - {m['name']}")
        return "multiple"
    return None



def wait_for_api(max_wait=5):
    start = time.time()
    while time.time() - start < max_wait:
        try:
            req = urllib.request.Request(f"{API_URL}/proxies", headers={"User-Agent": "proxy-node/1.0"})
            with urllib.request.urlopen(req, timeout=1) as resp:
                if resp.status == 200:
                    return True
        except Exception:
            time.sleep(0.3)
    return False


def get_proxies():
    req = urllib.request.Request(f"{API_URL}/proxies", headers={"User-Agent": "proxy-node/1.0"})
    with urllib.request.urlopen(req, timeout=3) as resp:
        return json.loads(resp.read().decode("utf-8"))


def get_current_selector():
    req = urllib.request.Request(f"{API_URL}/proxies/{PROXY_TAG}", headers={"User-Agent": "proxy-node/1.0"})
    with urllib.request.urlopen(req, timeout=3) as resp:
        return json.loads(resp.read().decode("utf-8"))


def set_proxy(node_name):
    data = json.dumps({"name": node_name}).encode("utf-8")
    req = urllib.request.Request(
        f"{API_URL}/proxies/{PROXY_TAG}",
        data=data,
        headers={"Content-Type": "application/json", "User-Agent": "proxy-node/1.0"},
        method="PUT",
    )
    with urllib.request.urlopen(req, timeout=5) as resp:
        return resp.status in (200, 204)


def cmd_list(port=PORT_HTTP):
    if not port:
        port = PORT_HTTP
    try:
        port = int(port)
    except Exception:
        port = PORT_HTTP

    if port != PORT_HTTP:
        return cmd_port_nodes(port)

    try:
        data = get_proxies()
        proxies_map = data.get("proxies", {})
        selector = proxies_map.get(PROXY_TAG, {})
        if not selector:
            for k, v in proxies_map.items():
                if v.get("type") == "Selector":
                    selector = v
                    break
        now_node = selector.get("now", "")
        all_nodes = selector.get("all", [])

        if not all_nodes:
            print(f"{COLOR_YELLOW}[!] No outbounds found in selector '{PROXY_TAG}'.{COLOR_RESET}")
            return 0

        active_prof = get_current_profile_name()
        prof_header = f" (Profile: {active_prof})" if active_prof else ""
        print(f"\n{COLOR_BOLD}{COLOR_CYAN}=== Available Proxy Nodes (Port {port}){prof_header} ({len(all_nodes)} total) ==={COLOR_RESET}")
        print("-" * 68)
        print(f" {'#':<4} {'Type':<12} {'Status':<12} {'Node Name'}")
        print("-" * 68)
        for idx, name in enumerate(all_nodes, 1):
            info = proxies_map.get(name, {})
            ntype = info.get("type", "Proxy")
            if name == now_node:
                status = "[*] Active"
                print(f" {COLOR_GREEN}{idx:<4} {ntype:<12} {status:<12} {name}{COLOR_RESET}")
            else:
                print(f" {idx:<4} {ntype:<12} {'':<12} {name}")
        print("-" * 68)
        print(f"Current active node: {COLOR_GREEN}{COLOR_BOLD}{now_node}{COLOR_RESET}")
        print(f"Switch node:    {COLOR_CYAN}pnode <#|name>{COLOR_RESET}        (e.g. 'pnode 2', 'pnode 日本')")
        print(f"Switch profile: {COLOR_CYAN}pnode use <#|name>{COLOR_RESET}     (e.g. 'pnode use 1')")
        print(f"Multi-port:     {COLOR_CYAN}pnode 1081 use <#|name>{COLOR_RESET} (or: 'pnode add <profile>')\n")
        return 0
    except Exception as e:
        print(f"{COLOR_YELLOW}[!] Cannot connect to sing-box Clash API (127.0.0.1:9090): {e}{COLOR_RESET}")
        if os.path.exists(CONFIG_PATH):
            try:
                with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                    cfg = json.load(f)
                outbounds = cfg.get("outbounds", [])
                print(f"{COLOR_CYAN}Nodes listed in {CONFIG_PATH}:{COLOR_RESET}")
                idx = 1
                for ob in outbounds:
                    if ob.get("type") not in ("selector", "direct", "block", "dns"):
                        print(f" {idx:<4} {ob.get('type', ''):<12} {ob.get('tag', '')}")
                        idx += 1
            except Exception:
                pass
        print("Please check if sing-box-client is running: systemctl status sing-box-client")
        return 1


def cmd_profile_list(args=None):
    auto_init_current_profile_if_needed()
    profiles = list_profiles()
    current_name = get_current_profile_name()

    if not profiles:
        print(f"\n{COLOR_YELLOW}[!] No saved config profiles found in {PROFILES_DIR}.{COLOR_RESET}")
        print(f"Save current config using: {COLOR_CYAN}pnode profile save <name>{COLOR_RESET}\n")
        return

    print(f"\n{COLOR_BOLD}{COLOR_CYAN}=== Configured Proxy Profiles ({len(profiles)} total) ==={COLOR_RESET}")
    print("-" * 84)
    print(f" {'#':<4} {'Status':<12} {'Profile Name':<18} {'Nodes':<8} {'Type':<14} {'Source / Date'}")
    print("-" * 84)
    bound_ports = get_bound_ports()
    for idx, p in enumerate(profiles, 1):
        p_name = p["name"]
        assigned_ports = [str(pt) for pt, info in bound_ports.items() if info.get("profile") == p_name]
        if p_name == current_name:
            if assigned_ports:
                status_str = f"{COLOR_GREEN}1080,{','.join(assigned_ports)}{COLOR_RESET}"
            else:
                status_str = f"{COLOR_GREEN}[*] Active{COLOR_RESET}"
        elif assigned_ports:
            status_str = f"{COLOR_CYAN}Port {','.join(assigned_ports)}{COLOR_RESET}"
        else:
            status_str = ""

        source_display = p["source"]
        if source_display:
            if len(source_display) > 28:
                source_display = source_display[:25] + "..."
            info_str = f"{source_display} ({p['mtime_str']})"
        else:
            info_str = p["mtime_str"]

        ptype_display = p["type"].capitalize()
        if p["name"] == current_name:
            print(f" {COLOR_GREEN}{idx:<4} {status_str:<21} {COLOR_BOLD}{p_name:<18}{COLOR_RESET} {p['node_count']:<8} {ptype_display:<14} {info_str}")
        else:
            print(f" {idx:<4} {status_str:<21} {p_name:<18} {p['node_count']:<8} {ptype_display:<14} {info_str}")
    print("-" * 84)
    if current_name:
        print(f"Current active profile (Port 1080): {COLOR_GREEN}{COLOR_BOLD}{current_name}{COLOR_RESET}")
    else:
        print(f"Current active profile (Port 1080): {COLOR_YELLOW}custom / unnamed{COLOR_RESET}")
    print(f"\nProfile Commands:")
    print(f"  Switch (Port 1080): {COLOR_CYAN}pnode use <#|name>{COLOR_RESET}        (e.g. 'pnode use 1', 'pnode use jp')")
    print(f"  Auto Add Port:      {COLOR_CYAN}pnode add <#|name>{COLOR_RESET}        (e.g. 'pnode add 2' -> auto starts on 1081)")
    print(f"  Host on Port:       {COLOR_CYAN}pnode [port] use <#|name>{COLOR_RESET} (e.g. 'pnode 1081 use 2')")
    print(f"  Delete Profile:     {COLOR_CYAN}pnode profile del <#|name>{COLOR_RESET}")
    print(f"  Save Current:       {COLOR_CYAN}pnode profile save <name>{COLOR_RESET}")
    print(f"  Add Profile:        {COLOR_CYAN}pnode profile add <name> <url|vless|file>{COLOR_RESET}\n")


def cmd_profile_use(target):
    auto_init_current_profile_if_needed()
    profiles = list_profiles()
    if not profiles:
        print(f"{COLOR_RED}[✗] No profiles found.{COLOR_RESET}")
        return 1

    if not target:
        if sys.stdin.isatty():
            cmd_profile_list()
            try:
                choice = input(f"{COLOR_BOLD}Enter profile number or name to switch [1-{len(profiles)}]: {COLOR_RESET}").strip()
                if not choice:
                    print("Cancelled.")
                    return 0
                target = choice
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                return 0
        else:
            print("Usage: pnode profile use <name|number>")
            return 1

    prof = resolve_profile(target, profiles)
    if prof == "multiple":
        return 1
    if not prof:
        print(f"{COLOR_RED}[✗] Profile '{target}' not found. Run 'pnode profile list' to see available profiles.{COLOR_RESET}")
        return 1

    target_name = prof["name"]
    target_json = prof["path"]
    meta_path = prof["meta_path"]

    check_bin = get_sing_box_binary()
    if check_bin:
        res = subprocess.run([check_bin, "check", "-c", target_json], capture_output=True, text=True)
        if res.returncode != 0:
            print(f"{COLOR_RED}[✗] Profile '{target_name}' failed sing-box validation:{COLOR_RESET}\n{res.stderr or res.stdout}")
            return 1

    if os.path.exists(CONFIG_PATH):
        try:
            shutil.copy2(CONFIG_PATH, f"{CONFIG_PATH}.bak")
        except Exception:
            pass

    try:
        shutil.copy2(target_json, CONFIG_PATH)
        os.chmod(CONFIG_PATH, 0o644)
    except Exception as e:
        print(f"{COLOR_RED}[✗] Failed to apply profile config: {e}{COLOR_RESET}")
        return 1

    if os.path.exists(meta_path):
        try:
            with open(meta_path, "r", encoding="utf-8") as f:
                meta = json.load(f)
            if meta.get("type") in ("subscription", "Subscription") and meta.get("source", "").startswith("http"):
                with open(SUB_URL_PATH, "w", encoding="utf-8") as f:
                    f.write(meta["source"].strip() + "\n")
            else:
                if os.path.exists(SUB_URL_PATH):
                    os.remove(SUB_URL_PATH)
        except Exception:
            pass
    else:
        if os.path.exists(SUB_URL_PATH):
            os.remove(SUB_URL_PATH)

    set_current_profile_name(target_name)

    print(f"Applying profile '{COLOR_BOLD}{target_name}{COLOR_RESET}' and restarting sing-box-client...")
    subprocess.run(["systemctl", "restart", "sing-box-client"])
    wait_for_api(5)

    res = subprocess.run(["systemctl", "is-active", "--quiet", "sing-box-client"])
    if res.returncode != 0:
        print(f"{COLOR_RED}[✗] sing-box-client failed to start with profile '{target_name}'. Rolling back...{COLOR_RESET}")
        if os.path.exists(f"{CONFIG_PATH}.bak"):
            shutil.copy2(f"{CONFIG_PATH}.bak", CONFIG_PATH)
            subprocess.run(["systemctl", "restart", "sing-box-client"])
        return 1

    print(f"{COLOR_GREEN}[✓] Successfully switched to profile: {COLOR_BOLD}{target_name}{COLOR_RESET}")
    cmd_list(PORT_HTTP)
    return 0


def cmd_profile_del(target, force=False):
    profiles = list_profiles()
    if not profiles:
        print(f"{COLOR_YELLOW}[!] No profiles found.{COLOR_RESET}")
        return 0

    if not target:
        if sys.stdin.isatty():
            cmd_profile_list()
            try:
                choice = input(f"{COLOR_BOLD}Enter profile number or name to delete [1-{len(profiles)}]: {COLOR_RESET}").strip()
                if not choice:
                    print("Cancelled.")
                    return 0
                target = choice
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                return 0
        else:
            print("Usage: pnode profile del <name|number>")
            return 1

    prof = resolve_profile(target, profiles)
    if prof == "multiple":
        return 1
    if not prof:
        print(f"{COLOR_RED}[✗] Profile '{target}' not found.{COLOR_RESET}")
        return 1

    target_name = prof["name"]
    is_active = prof["is_active"]

    if is_active:
        print(f"{COLOR_YELLOW}[!] Note: Profile '{target_name}' is currently ACTIVE on Port 1080.{COLOR_RESET}")
        print(f"    Deleting it removes the saved profile record. sing-box-client continues running the current config until you switch profiles.")

    bound_ports = [str(pt) for pt, p_info in get_bound_ports().items() if p_info.get("profile") == target_name]
    if bound_ports:
        print(f"{COLOR_YELLOW}[!] Warning: Profile '{target_name}' is currently bound to port(s): {', '.join(bound_ports)}.{COLOR_RESET}")
        print(f"    To unbind first, run: {COLOR_CYAN}pnode port unbind <port>{COLOR_RESET}")

    if not force and sys.stdin.isatty():
        try:
            confirm = input(f"Are you sure you want to delete profile '{COLOR_BOLD}{target_name}{COLOR_RESET}'? [y/N]: ").strip().lower()
            if confirm not in ("y", "yes"):
                print("Deletion cancelled.")
                return 0
        except (KeyboardInterrupt, EOFError):
            print("\nDeletion cancelled.")
            return 0

    if os.path.exists(prof["path"]):
        os.remove(prof["path"])
    if os.path.exists(prof["meta_path"]):
        os.remove(prof["meta_path"])

    if is_active:
        set_current_profile_name(None)

    print(f"{COLOR_GREEN}[✓] Successfully deleted profile: {COLOR_BOLD}{target_name}{COLOR_RESET}")
    return 0


def cmd_profile_save(name):
    if not name:
        if sys.stdin.isatty():
            try:
                name = input(f"{COLOR_BOLD}Enter name for current profile: {COLOR_RESET}").strip()
                if not name:
                    print("Cancelled.")
                    return 0
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                return 0
        else:
            print("Usage: pnode profile save <name>")
            return 1

    if not os.path.exists(CONFIG_PATH):
        print(f"{COLOR_RED}[✗] Active config not found at {CONFIG_PATH}.{COLOR_RESET}")
        return 1

    ptype = "Custom"
    source = ""
    if os.path.exists(SUB_URL_PATH):
        try:
            with open(SUB_URL_PATH, "r", encoding="utf-8") as f:
                source = f.read().strip()
            if source:
                ptype = "subscription"
        except Exception:
            pass

    ok = save_profile(name, CONFIG_PATH, ptype=ptype, source=source)
    if ok:
        set_current_profile_name(name)
        print(f"{COLOR_GREEN}[✓] Current configuration saved as profile: {COLOR_BOLD}{name}{COLOR_RESET}")
        return 0
    return 1


def cmd_profile_add(name, source, use=False):
    if not name or not source:
        print("Usage: pnode profile add <name> <url|vless|filepath>")
        return 1

    if not re.match(r'^[a-zA-Z0-9_\-]+$', name):
        print(f"{COLOR_RED}[✗] Invalid profile name '{name}'. Use letters, numbers, hyphens, underscores.{COLOR_RESET}")
        return 1

    converter = get_converter_path()
    if not converter:
        print(f"{COLOR_RED}[✗] sub_converter.py not found on system.{COLOR_RESET}")
        return 1

    ensure_profiles_dir()
    dest_json = os.path.join(PROFILES_DIR, f"{name}.json")

    print(f"Adding profile '{name}' from source: {source} ...")
    if source.startswith("http://") or source.startswith("https://"):
        cmd = [sys.executable, converter, "--sub", source, "--output", dest_json]
        ptype = "subscription"
    elif source.startswith("vless://"):
        cmd = [sys.executable, converter, "--vless", source, "--output", dest_json]
        ptype = "vless"
    elif os.path.exists(source):
        cmd = [sys.executable, converter, "--file", source, "--output", dest_json]
        ptype = "file"
    else:
        print(f"{COLOR_RED}[✗] Invalid source (must be a valid URL, vless:// URI, or local file path): {source}{COLOR_RESET}")
        return 1

    ret = subprocess.run(cmd)
    if ret.returncode != 0:
        print(f"{COLOR_RED}[✗] Failed to generate configuration for '{name}'.{COLOR_RESET}")
        return 1

    node_count, _, _ = inspect_config_file(dest_json)
    meta = {
        "name": name,
        "type": ptype,
        "source": source,
        "node_count": node_count,
        "updated_at": time.strftime("%Y-%m-%d %H:%M:%S"),
    }
    try:
        with open(os.path.join(PROFILES_DIR, f"{name}.meta.json"), "w", encoding="utf-8") as f:
            json.dump(meta, f, indent=2)
    except Exception:
        pass

    print(f"{COLOR_GREEN}[✓] Profile '{COLOR_BOLD}{name}{COLOR_RESET}' successfully created ({node_count} nodes).")

    if use:
        return cmd_profile_use(name)
    else:
        print(f"To activate this profile, run: {COLOR_CYAN}pnode profile use {name}{COLOR_RESET}")
        return 0


def handle_profile_action(subaction, target, extra, force=False):
    if not subaction or subaction in ("list", "ls"):
        cmd_profile_list()
        return 0
    elif subaction in ("use", "switch", "select"):
        return cmd_profile_use(target)
    elif subaction in ("del", "rm", "delete", "remove"):
        return cmd_profile_del(target, force=force)
    elif subaction in ("save", "add-current"):
        return cmd_profile_save(target)
    elif subaction == "add":
        return cmd_profile_add(target, extra)
    else:
        profiles = list_profiles()
        prof = resolve_profile(subaction, profiles)
        if prof and prof != "multiple":
            return cmd_profile_use(prof["name"])
        else:
            print(f"Unknown profile action or name: '{subaction}'")
            cmd_profile_list()
            return 1


def cmd_profile(args):
    subaction = args.subaction
    target = args.target
    extra = args.extra
    force = getattr(args, "force", False)
    return handle_profile_action(subaction, target, extra, force=force)


def cmd_config(args):
    subaction = args.subaction
