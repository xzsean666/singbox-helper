        print(f"{COLOR_RED}[✗] Port {port} service is not running.{COLOR_RESET}")
        return 1

    try:
        req = urllib.request.Request(f"http://127.0.0.1:{api_port}/proxies", headers={"User-Agent": "proxy-node/1.0"})
        with urllib.request.urlopen(req, timeout=2) as resp:
