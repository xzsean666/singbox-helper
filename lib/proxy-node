            os.remove(cache_file)
        except Exception:
            pass

    print(f"{COLOR_GREEN}[✓] Successfully stopped and unbound port {port} (was '{profile_name}').{COLOR_RESET}")
    return 0


def cmd_use(port, profile_target, force=False):
    auto_init_current_profile_if_needed()
    profiles = list_profiles()
    if not profiles:
        print(f"{COLOR_RED}[✗] No profiles found. Add a profile first with 'pnode profile add'.{COLOR_RESET}")
        return 1

    if not profile_target:
        if sys.stdin.isatty():
            cmd_profile_list()
            try:
                profile_target = input(f"{COLOR_BOLD}Enter profile number or name for Port {port} [1-{len(profiles)}]: {COLOR_RESET}").strip()
                if not profile_target:
                    print("Cancelled.")
                    return 0
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                return 0
        else:
            print(f"Usage: pnode {port if port != 1080 else ''} use <profile>")
            return 1

    prof = resolve_profile(profile_target, profiles)
    if prof == "multiple":
        return 1
    if not prof:
        print(f"{COLOR_RED}[✗] Profile '{profile_target}' not found. Run 'pnode profiles' to see available profiles.{COLOR_RESET}")
        return 1

    target_name = prof["name"]

    if port == PORT_HTTP:
        return cmd_profile_use(target_name)
    else:
        return cmd_port_bind(port, target_name, force=force)


def cmd_add_auto_port(profile_target, force=False):
    auto_init_current_profile_if_needed()
    profiles = list_profiles()
    if not profiles:
        print(f"{COLOR_RED}[✗] No profiles found. Add a profile first with 'pnode profile add'.{COLOR_RESET}")
        return 1

    next_port = find_next_free_proxy_port(1081, 1180)
    if not next_port:
        print(f"{COLOR_RED}[✗] No free proxy ports found in range 1081-1180.{COLOR_RESET}")
        return 1

    if not profile_target:
        if sys.stdin.isatty():
            cmd_profile_list()
            try:
                profile_target = input(f"{COLOR_BOLD}Enter profile number or name to start on Port {next_port} [1-{len(profiles)}]: {COLOR_RESET}").strip()
                if not profile_target:
                    print("Cancelled.")
                    return 0
            except (KeyboardInterrupt, EOFError):
                print("\nCancelled.")
                return 0
        else:
            print("Usage: pnode add <profile>")
            return 1

    prof = resolve_profile(profile_target, profiles)
    if prof == "multiple":
        return 1
    if not prof:
        print(f"{COLOR_RED}[✗] Profile '{profile_target}' not found. Run 'pnode profiles' to see available profiles.{COLOR_RESET}")
        return 1

    ret = cmd_port_bind(next_port, prof["name"], force=force)
    if ret == 0:
        print(f"Tip: run '{COLOR_CYAN}proxy on {next_port}{COLOR_RESET}' to route your current shell through this port.\n")
    return ret


def cmd_stop_all(force=False):
    bound = get_bound_ports()
    if not bound:
        print("No secondary ports currently running.")
        return 0
    ports = sorted(bound.keys())
    if not force and sys.stdin.isatty():
        try:
            confirm = input(f"Stop and unbind all secondary ports ({', '.join(map(str, ports))})? [y/N]: ").strip().lower()
            if confirm not in ("y", "yes"):
                print("Cancelled.")
                return 0
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            return 0
    for p in ports:
        cmd_port_unbind(p, force=True)
    print(f"{COLOR_GREEN}[✓] All secondary ports stopped. Primary port 1080 remains running.{COLOR_RESET}")
    return 0


def cmd_stop(target=None, force=False):
    if target == "all":
        return cmd_stop_all(force=force)

    if target:
        try:
            port = int(target)
            return cmd_port_unbind(port, force=force)
        except ValueError:
            pass

    bound = get_bound_ports()
    if not bound:
        print(f"{COLOR_YELLOW}[!] No secondary ports currently running to stop.{COLOR_RESET}")
        return 0

    if sys.stdin.isatty():
        cmd_dashboard()
        try:
            choice = input(f"{COLOR_BOLD}Enter port to stop (or 'all'): {COLOR_RESET}").strip()
            if not choice:
                print("Cancelled.")
                return 0
            if choice.lower() == "all":
                return cmd_stop_all(force=force)
            else:
                return cmd_port_unbind(int(choice), force=force)
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            return 0
    else:
        print("Usage: pnode [port] stop | pnode stop <port|all>")
        return 1


def cmd_run(port, cmd_args):
    if not cmd_args:
        print("Usage: pnode [port] run <command...>")
        print("Example: pnode 1081 run curl -s https://api.ipify.org")
        return 1
    env = os.environ.copy()
    proxy_url = f"http://127.0.0.1:{port}"
    socks_url = f"socks5://127.0.0.1:{port}"
    env["http_proxy"] = proxy_url
    env["https_proxy"] = proxy_url
    env["HTTP_PROXY"] = proxy_url
    env["HTTPS_PROXY"] = proxy_url
    env["all_proxy"] = socks_url
    env["ALL_PROXY"] = socks_url
    try:
        res = subprocess.run(cmd_args, env=env)
        return res.returncode
    except Exception as e:
        print(f"{COLOR_RED}[✗] Failed to run command: {e}{COLOR_RESET}")
        return 1


def handle_profile_cmd(sub_args, force=False):
    if not sub_args or sub_args[0] in ("list", "ls"):
        return cmd_profile_list()
    action = sub_args[0].lower()
    target = sub_args[1] if len(sub_args) > 1 else None
    extra = sub_args[2] if len(sub_args) > 2 else None

    if action in ("add", "new"):
        return cmd_profile_add(target, extra)
    elif action in ("del", "rm", "delete"):
        return cmd_profile_del(target, force=force)
    elif action in ("save", "add-current"):
        return cmd_profile_save(target)
    elif action == "use":
        return cmd_use(PORT_HTTP, target, force=force)
    else:
        profiles = list_profiles()
        prof = resolve_profile(sub_args[0], profiles)
        if prof and prof != "multiple":
            return cmd_use(PORT_HTTP, prof["name"], force=force)
        print(f"Unknown profile command: {sub_args[0]}")
        print("Commands: pnode profiles | pnode profile add | pnode profile del | pnode profile save")
        return 1


def cmd_port_legacy(sub_args, force=False):
    if not sub_args or sub_args[0].lower() in ("list", "ls", "status"):
        return cmd_dashboard()
    action = sub_args[0].lower()
    if action in ("bind", "add"):
        if len(sub_args) >= 3 and sub_args[1].isdigit():
            return cmd_port_bind(int(sub_args[1]), sub_args[2], force=force)
        elif len(sub_args) >= 2:
            return cmd_add_auto_port(sub_args[1], force=force)
        return cmd_add_auto_port(None, force=force)
    elif action in ("unbind", "del", "stop", "rm"):
        if len(sub_args) >= 2:
            return cmd_stop(sub_args[1], force=force)
        return cmd_stop(force=force)
    elif action == "test":
        p = int(sub_args[1]) if len(sub_args) > 1 and sub_args[1].isdigit() else None
        return cmd_test(p)
    elif action.isdigit():
        return cmd_list(int(action))
    return cmd_dashboard()


